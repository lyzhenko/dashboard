////////////////////////////////////////////////////////////////////////////////
// D_Показатели — расчёт показателей предприятия для дашборда руководителя.
//
// Модуль только читает данные: ни одна функция не изменяет базу.
// Контракт ответов — docs/API-КОНТРАКТ.md, обоснование формул — docs/РАСЧЁТ-ПОКАЗАТЕЛЕЙ.md.
//
// Источники и формулы выбраны по типовой логике УНФ (общий модуль
// СостояниеКомпании, обработка ПульсБизнеса), а не придуманы заново.
//
// Соглашения:
//   * деньги — числа в рублях с копейками, округление до 2 знаков;
//   * в JSON не бывает null: отсутствие данных выражается нулём, пустым массивом
//     или строкой; процент равен 0, если базы сравнения нет (смотрите исходные суммы);
//   * все периоды трактуются календарно и заканчиваются датой отчёта.

#Область ПрограммныйИнтерфейс

// Сведения о сервисе. Используется методом /health.
//
// Возвращаемое значение:
//   Структура - см. контракт, раздел 1.1.
Функция СведенияОСервисе() Экспорт
	
	ИмяКонфигурации = "";
	Попытка
		ИмяКонфигурации = СокрЛП(Строка(Метаданные.Имя) + " " + Строка(Метаданные.Версия));
	Исключение
		// Состав свойств корневых метаданных зависит от версии платформы:
		// недоступность версии не должна ломать проверку доступности сервиса.
		ИмяКонфигурации = "";
	КонецПопытки;
	
	Результат = Новый Структура;
	Результат.Вставить("status", "ok");
	Результат.Вставить("service", "D_DashboardApi");
	Результат.Вставить("version", ВерсияСервиса());
	Результат.Вставить("configuration", ИмяКонфигурации);
	Результат.Вставить("serverTime", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	
	Возврат Результат;
	
КонецФункции

// Самопроверка расчёта показателей.
//
// Считает все показатели, собирает отчёт и отправляет его по HTTP. Нужна, чтобы
// проверить расчёт на живой базе, когда веб-публикация недоступна: регламентное
// задание D_СамопроверкаПоказателей вызывает эту функцию, а отчёт принимает
// tools\kpi-probe-listener.ps1.
//
// Каждая проверка выполняется независимо: ошибка одной не мешает остальным и
// попадает в отчёт отдельной записью с текстом ошибки.
//
// Параметры:
//   Хост - Строка - адрес приёмника отчёта.
//   Порт - Число - порт приёмника.
//   Путь - Строка - ресурс приёмника.
//
// Возвращаемое значение:
//   Структура - отчёт: checks (массив проверок), failed (число неудач), delivered.
Функция Самопроверка(Знач Хост = "127.0.0.1", Знач Порт = 8123, Знач Путь = "/report") Экспорт
	
	Отчет = Новый Структура;
	Отчет.Вставить("serverTime", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Отчет.Вставить("checks", Новый Массив);
	Отчет.Вставить("failed", 0);
	
	// Те же параметры, что в HTTP-сервисе приходят из строки запроса.
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("date", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd"));
	ПараметрыЗапроса.Вставить("period", "month");
	ПараметрыЗапроса.Вставить("organization", "");
	
	Попытка
		Сведения = СведенияОСервисе();
		ЗаписатьПроверку(Отчет, "СведенияОСервисе", Истина,
			СтрШаблон("конфигурация: %1; версия сервиса: %2", Сведения.configuration, Сведения.version), Неопределено);
	Исключение
		ЗаписатьПроверку(Отчет, "СведенияОСервисе", Ложь, ОписаниеОшибки(), Неопределено);
	КонецПопытки;
	
	Попытка
		Организации = СписокОрганизаций();
		ЗаписатьПроверку(Отчет, "СписокОрганизаций", Истина,
			СтрШаблон("организаций в базе: %1", Организации.items.Количество()), Неопределено);
	Исключение
		ЗаписатьПроверку(Отчет, "СписокОрганизаций", Ложь, ОписаниеОшибки(), Неопределено);
	КонецПопытки;
	
	// Главная проверка: внутри выполняются все семь запросов показателей.
	Сводка = Неопределено;
	Попытка
		Сводка = СводкаПоказателей(ПараметрыKPI(ПараметрыЗапроса));
		Итоги = Новый Структура;
		Итоги.Вставить("money", Сводка.money.total);
		Итоги.Вставить("accounts", Сводка.money.accounts);
		Итоги.Вставить("cash", Сводка.money.cash);
		Итоги.Вставить("revenue", Сводка.sales.revenue);
		Итоги.Вставить("grossProfit", Сводка.sales.grossProfit);
		Итоги.Вставить("documents", Сводка.sales.documents);
		Итоги.Вставить("receivables", Сводка.receivables.total);
		Итоги.Вставить("receivablesOverdue", Сводка.receivables.overdue);
		Итоги.Вставить("payables", Сводка.payables.total);
		Итоги.Вставить("payablesOverdue", Сводка.payables.overdue);
		Итоги.Вставить("stock", Сводка.stock.total);
		Итоги.Вставить("skuCount", Сводка.stock.skuCount);
		Итоги.Вставить("ordersPortfolio", Сводка.orders.portfolio);
		Итоги.Вставить("ordersCount", Сводка.orders.count);
		Итоги.Вставить("topDebtorsCount", Сводка.topDebtors.Количество());
		ЗаписатьПроверку(Отчет, "СводкаПоказателей", Истина, "все семь блоков посчитаны", Итоги);
	Исключение
		ЗаписатьПроверку(Отчет, "СводкаПоказателей", Ложь, ОписаниеОшибки(), Неопределено);
	КонецПопытки;
	
	Попытка
		ПараметрыДинамики = Новый Структура;
		ПараметрыДинамики.Вставить("ДатаОтчета", НачалоДня(ТекущаяДата()));
		ПараметрыДинамики.Вставить("Месяцев", 12);
		ПараметрыДинамики.Вставить("Организация", Неопределено);
		Динамика = ДинамикаПоказателей(ПараметрыДинамики);
		Итоги = Новый Структура;
		Итоги.Вставить("months", Динамика.items.Количество());
		ЗаписатьПроверку(Отчет, "ДинамикаПоказателей", Истина,
			СтрШаблон("месяцев в ответе: %1", Динамика.items.Количество()), Итоги);
	Исключение
		ЗаписатьПроверку(Отчет, "ДинамикаПоказателей", Ложь, ОписаниеОшибки(), Неопределено);
	КонецПопытки;
	
	Попытка
		ПараметрыЗадолженности = Новый Структура;
		ПараметрыЗадолженности.Вставить("ДатаОтчета", НачалоДня(ТекущаяДата()));
		ПараметрыЗадолженности.Вставить("Вид", "receivable");
		ПараметрыЗадолженности.Вставить("Предел", 5);
		ПараметрыЗадолженности.Вставить("Организация", Неопределено);
		Долги = ЗадолженностьПоКонтрагентам(ПараметрыЗадолженности);
		Итоги = Новый Структура;
		Итоги.Вставить("total", Долги.total);
		Итоги.Вставить("overdue", Долги.overdue);
		Итоги.Вставить("items", Долги.items.Количество());
		ЗаписатьПроверку(Отчет, "ЗадолженностьПоКонтрагентам", Истина,
			СтрШаблон("контрагентов в ответе: %1", Долги.items.Количество()), Итоги);
	Исключение
		ЗаписатьПроверку(Отчет, "ЗадолженностьПоКонтрагентам", Ложь, ОписаниеОшибки(), Неопределено);
	КонецПопытки;
	
	// Сходимость: деньги целиком равны сумме счетов и кассы.
	Если Сводка <> Неопределено Тогда
		СуммаПоМестам = Сводка.money.accounts + Сводка.money.cash;
		ЗаписатьПроверку(Отчет, "Сходимость: деньги", Сводка.money.total = СуммаПоМестам,
			СтрШаблон("итог %1, счета и касса %2", Сводка.money.total, СуммаПоМестам), Неопределено);
	КонецЕсли;
	
	Отчет.Вставить("delivered", ОтправитьОтчетПоАдресу(Хост, Порт, Путь, Отчет));
	
	Возврат Отчет;
	
КонецФункции

// Список организаций для выбора на дашборде. Используется методом /organizations.
//
// Возвращаемое значение:
//   Структура - {"items": Массив структур {id, name, inn, isDefault}}.
Функция СписокОрганизаций() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка,
	|	Организации.Наименование КАК Наименование,
	|	Организации.ИНН КАК ИНН
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Элементы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Элемент.Вставить("name", СокрЛП(Выборка.Наименование));
		Элемент.Вставить("inn", СокрЛП(Выборка.ИНН));
		Элемент.Вставить("isDefault", Ложь);
		Элементы.Добавить(Элемент);
	КонецЦикла;
	
	// Организация по умолчанию — единственная в базе. Если их несколько,
	// дашборд по умолчанию показывает все организации сразу.
	Если Элементы.Количество() = 1 Тогда
		Элементы[0].Вставить("isDefault", Истина);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	
	Возврат Результат;
	
КонецФункции

// Разбирает параметры запроса сводки показателей.
//
// Параметры:
//   ПараметрыЗапроса - Структура - HTTPСервисЗапрос.ПараметрыЗапроса.
//
// Возвращаемое значение:
//   Структура - {ДатаОтчета, ВидПериода, Организация}.
//
// Вызывает исключение с префиксом ошибки запроса, если параметр недопустим.
Функция ПараметрыKPI(Знач ПараметрыЗапроса) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаОтчета", ДатаПараметра(ПараметрыЗапроса, "date"));
	Результат.Вставить("ВидПериода", ВидПериодаПараметра(ПараметрыЗапроса));
	Результат.Вставить("Организация", ОрганизацияПараметра(ПараметрыЗапроса));
	
	Возврат Результат;
	
КонецФункции

// Разбирает параметры запроса динамики по месяцам.
//
// Возвращаемое значение:
//   Структура - {ДатаОтчета, Месяцев, Организация}.
Функция ПараметрыДинамики(Знач ПараметрыЗапроса) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаОтчета", ДатаПараметра(ПараметрыЗапроса, "date"));
	Результат.Вставить("Месяцев", ЦелыйПараметр(ПараметрыЗапроса, "months", 12, 1, 36));
	Результат.Вставить("Организация", ОрганизацияПараметра(ПараметрыЗапроса));
	
	Возврат Результат;
	
КонецФункции

// Разбирает параметры запроса задолженности по контрагентам.
//
// Возвращаемое значение:
//   Структура - {ДатаОтчета, Вид, Предел, Организация}.
Функция ПараметрыЗадолженности(Знач ПараметрыЗапроса) Экспорт
	
	Вид = НРег(ЗначениеПараметра(ПараметрыЗапроса, "kind"));
	Если ПустаяСтрока(Вид) Тогда
		Вид = "receivable";
	КонецЕсли;
	Если Вид <> "receivable" И Вид <> "payable" Тогда
		ВызватьОшибкуЗапроса(СтрШаблон("Параметр kind имеет недопустимое значение: ""%1"". Допустимо: receivable, payable.", Вид));
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаОтчета", ДатаПараметра(ПараметрыЗапроса, "date"));
	Результат.Вставить("Вид", Вид);
	Результат.Вставить("Предел", ЦелыйПараметр(ПараметрыЗапроса, "limit", 10, 1, 100));
	Результат.Вставить("Организация", ОрганизацияПараметра(ПараметрыЗапроса));
	
	Возврат Результат;
	
КонецФункции

// Сводка показателей для главного экрана дашборда. Метод /kpi.
//
// Параметры:
//   Параметры - Структура - результат ПараметрыKPI().
//
// Возвращаемое значение:
//   Структура - см. контракт, раздел 1.3.
Функция СводкаПоказателей(Знач Параметры) Экспорт
	
	ДатаОтчета = Параметры.ДатаОтчета;
	Организация = Параметры.Организация;
	Границы = ГраницыПериода(Параметры.ВидПериода, ДатаОтчета);
	
	ПродажиТекущие = ПоказателиПродаж(Границы.ДатаС, Границы.ДатаПо, Организация);
	ПродажиПрошлые = ПоказателиПродаж(Границы.ПредДатаС, Границы.ПредДатаПо, Организация);
	
	Дебиторка = ЗадолженностьПоКонтрагентамВнутренняя("receivable", ДатаОтчета, Организация);
	Кредиторка = ЗадолженностьПоКонтрагентамВнутренняя("payable", ДатаОтчета, Организация);
	
	Результат = Новый Структура;
	Результат.Вставить("generatedAt", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Результат.Вставить("asOf", Формат(ДатаОтчета, "ДФ=yyyy-MM-dd"));
	Результат.Вставить("period", Новый Структура(
		"kind, from, to, prevFrom, prevTo",
		Границы.ВидПериода,
		Формат(Границы.ДатаС, "ДФ=yyyy-MM-dd"),
		Формат(Границы.ДатаПо, "ДФ=yyyy-MM-dd"),
		Формат(Границы.ПредДатаС, "ДФ=yyyy-MM-dd"),
		Формат(Границы.ПредДатаПо, "ДФ=yyyy-MM-dd")));
	Результат.Вставить("organization", ОписаниеОрганизации(Организация));
	Результат.Вставить("money", ПоказателиДенег(ДатаОтчета, Организация));
	Результат.Вставить("sales", ПоказателиПродажДляОтвета(ПродажиТекущие, ПродажиПрошлые));
	Результат.Вставить("receivables", ПоказателиЗадолженностиДляОтвета(Дебиторка));
	Результат.Вставить("payables", ПоказателиЗадолженностиДляОтвета(Кредиторка));
	Результат.Вставить("stock", ПоказателиЗапасов(ДатаОтчета, Организация));
	Результат.Вставить("orders", ПоказателиЗаказов(ДатаОтчета, Границы.ДатаС, Границы.ДатаПо, Организация));
	Результат.Вставить("topDebtors", ПервыеПоСумме(Дебиторка.ПоКонтрагентам, 5));
	Результат.Вставить("topSuppliers", ПервыеПоСумме(Кредиторка.ПоКонтрагентам, 5));
	
	Возврат Результат;
	
КонецФункции

// Выручка, валовая прибыль и рентабельность по месяцам. Метод /dynamics.
//
// Параметры:
//   Параметры - Структура - результат ПараметрыДинамики().
//
// Возвращаемое значение:
//   Структура - {"items": Массив структур {month, revenue, grossProfit, marginPct}}.
Функция ДинамикаПоказателей(Знач Параметры) Экспорт
	
	ДатаОтчета = Параметры.ДатаОтчета;
	Месяцев = Параметры.Месяцев;
	
	НачалоПервого = НачалоМесяца(ДобавитьМесяц(ДатаОтчета, -(Месяцев - 1)));
	КонецПериода = КонецДня(ДатаОтчета);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Продажи.Период, МЕСЯЦ) КАК Месяц,
	|	СУММА(Продажи.СуммаОборот) КАК Выручка,
	|	СУММА(Продажи.СебестоимостьОборот) КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, Месяц, " + УсловиеОрганизации() + ") КАК Продажи
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Продажи.Период, МЕСЯЦ)
	|УПОРЯДОЧИТЬ ПО
	|	Месяц";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПервого);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПоМесяцам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ПоМесяцам.Вставить(НачалоМесяца(Выборка.Месяц), Выборка);
	КонецЦикла;
	
	Элементы = Новый Массив;
	Для НомерМесяца = 0 По Месяцев - 1 Цикл
		Месяц = ДобавитьМесяц(НачалоПервого, НомерМесяца);
		Выручка = 0;
		Себестоимость = 0;
		СтрокаМесяца = ПоМесяцам.Получить(Месяц);
		Если СтрокаМесяца <> Неопределено Тогда
			Выручка = Окр(СтрокаМесяца.Выручка, 2);
			Себестоимость = Окр(СтрокаМесяца.Себестоимость, 2);
		КонецЕсли;
		
		Элемент = Новый Структура;
		Элемент.Вставить("month", Формат(Месяц, "ДФ=yyyy-MM"));
		Элемент.Вставить("revenue", Выручка);
		Элемент.Вставить("grossProfit", Окр(Выручка - Себестоимость, 2));
		Элемент.Вставить("marginPct", Процент(Выручка - Себестоимость, Выручка));
		Элементы.Добавить(Элемент);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	
	Возврат Результат;
	
КонецФункции

// Задолженность по контрагентам. Метод /debtors.
//
// Параметры:
//   Параметры - Структура - результат ПараметрыЗадолженности().
//
// Возвращаемое значение:
//   Структура - см. контракт, раздел 1.5.
Функция ЗадолженностьПоКонтрагентам(Знач Параметры) Экспорт
	
	Данные = ЗадолженностьПоКонтрагентамВнутренняя(Параметры.Вид, Параметры.ДатаОтчета, Параметры.Организация);
	
	Результат = Новый Структура;
	Результат.Вставить("kind", Параметры.Вид);
	Результат.Вставить("asOf", Формат(Параметры.ДатаОтчета, "ДФ=yyyy-MM-dd"));
	Результат.Вставить("total", Данные.Всего);
	Результат.Вставить("overdue", Данные.Просрочено);
	Результат.Вставить("items", ПервыеПоСумме(Данные.ПоКонтрагентам, Параметры.Предел, Истина));
	
	Возврат Результат;
	
КонецФункции

// Прерывает обработку запроса с ошибкой в параметрах (ответ 400).
//
// Параметры:
//   Текст - Строка - описание ошибки для клиента.
Процедура ВызватьОшибкуЗапроса(Знач Текст) Экспорт
	
	ВызватьИсключение(ПрефиксОшибкиЗапроса() + Текст);
	
КонецПроцедуры

// Формирует успешный ответ HTTP-сервиса с телом JSON.
//
// Параметры:
//   Данные - Структура - тело ответа.
//
// Возвращаемое значение:
//   HTTPСервисОтвет.
Функция УспешныйОтвет(Знач Данные) Экспорт
	
	Возврат ОтветJSON(200, "OK", Данные);
	
КонецФункции

// Формирует ответ об ошибке. Различает ошибку в параметрах запроса (400)
// и внутреннюю ошибку (500) по префиксу, который ставит ВызватьОшибкуЗапроса().
//
// Параметры:
//   ОписаниеОшибки - Строка - результат ОписаниеОшибки().
//
// Возвращаемое значение:
//   HTTPСервисОтвет.
Функция ОтветОшибки(Знач ОписаниеОшибки) Экспорт
	
	Текст = СокрЛП(ОписаниеОшибки);
	Позиция = СтрНайти(Текст, ПрефиксОшибкиЗапроса());
	
	Если Позиция > 0 Тогда
		КодСостояния = 400;
		Причина = "Bad Request";
		КодОшибки = "bad_request";
		Текст = СокрЛП(Сред(Текст, Позиция + СтрДлина(ПрефиксОшибкиЗапроса())));
	Иначе
		КодСостояния = 500;
		Причина = "Internal Server Error";
		КодОшибки = "internal";
		Текст = СтрШаблон("Внутренняя ошибка сервиса: %1", Текст);
	КонецЕсли;
	
	Если ПустаяСтрока(Текст) Тогда
		Текст = "Не удалось получить описание ошибки.";
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("error", Новый Структура("code, message", КодОшибки, Текст));
	
	Возврат ОтветJSON(КодСостояния, Причина, Тело);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет запись о проверке в отчёт и считает неудачи.
Процедура ЗаписатьПроверку(Знач Отчет, Знач Имя, Знач Успех, Знач Пояснение, Знач Итоги)
	
	Проверка = Новый Структура;
	Проверка.Вставить("name", Имя);
	Проверка.Вставить("ok", Успех);
	Проверка.Вставить("detail", Пояснение);
	Если Итоги = Неопределено Тогда
		Проверка.Вставить("totals", Новый Структура);
	Иначе
		Проверка.Вставить("totals", Итоги);
	КонецЕсли;
	
	Отчет.checks.Добавить(Проверка);
	Если НЕ Успех Тогда
		Отчет.failed = Отчет.failed + 1;
	КонецЕсли;
	
КонецПроцедуры

// Отправляет отчёт о самопроверке по HTTP.
//
// Недоступный приёмник не должен валить регламентное задание: результат проверки
// важнее факта доставки, поэтому ошибка отправки возвращает Ложь.
Функция ОтправитьОтчетПоАдресу(Знач Хост, Знач Порт, Знач Путь, Знач Отчет)
	
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Отчет);
		ТелоОтчета = ЗаписьJSON.Закрыть();
		
		Соединение = Новый HTTPСоединение(Хост, Порт, , , , 30);
		Запрос = Новый HTTPЗапрос(Путь);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ТелоОтчета);
		
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Возврат Ответ.КодСостояния = 200;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ВерсияСервиса()
	
	Возврат "1.0.0";
	
КонецФункции

Функция ПрефиксОшибкиЗапроса()
	
	// Маркер различает ошибку в параметрах и внутреннюю ошибку при разборе
	// текста исключения: отдельного типа исключений в BSL нет.
	Возврат "D_DASHBOARD_BAD_REQUEST:";
	
КонецФункции

Функция ОтветJSON(Знач КодСостояния, Знач Причина, Знач Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ТелоОтвета = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния, Причина);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	
	Возврат Ответ;
	
КонецФункции

Функция УсловиеОрганизации()
	
	// Одна и та же строка используется и в виртуальных таблицах, и в условии ГДЕ.
	// Пустая организация означает «все организации».
	Возврат "Организация = &Организация ИЛИ &Организация = НЕОПРЕДЕЛЕНО";
	
КонецФункции

Функция ОписаниеОрганизации(Знач Организация)
	
	Результат = Новый Структура;
	Если ЗначениеЗаполнено(Организация) Тогда
		Результат.Вставить("id", Строка(Организация.УникальныйИдентификатор()));
		Результат.Вставить("name", СокрЛП(Организация.Наименование));
	Иначе
		Результат.Вставить("id", "");
		Результат.Вставить("name", "Все организации");
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция Процент(Знач Числитель, Знач Знаменатель)
	
	Если Знаменатель = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Окр(100 * Числитель / Знаменатель, 2);
	
КонецФункции

// Замена функции языка запросов ЕстьNULL для результатов запроса, прочитанных в BSL.
//
// Агрегат по пустой выборке возвращает NULL (а не ноль), а обращение к полю
// отсутствующей строки — Неопределено. Оба случая означают «данных нет» и оба
// обязаны превращаться в ноль: иначе Окр(NULL, 2) падает с ошибкой
// «Преобразование значения к типу Число не может быть выполнено».
Функция НольЕслиПусто(Знач Значение, Знач ЗначениеПоУмолчанию = 0)
	
	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Разбор параметров запроса

Функция ЗначениеПараметра(Знач ПараметрыЗапроса, Знач Имя)
	
	Если ПараметрыЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Если НРег(Строка(КлючИЗначение.Ключ)) = НРег(Имя) Тогда
			Значение = КлючИЗначение.Значение;
			Если ТипЗнч(Значение) = Тип("Массив") Тогда
				Если Значение.Количество() = 0 Тогда
					Возврат "";
				КонецЕсли;
				Возврат СокрЛП(Строка(Значение[0]));
			КонецЕсли;
			Возврат СокрЛП(Строка(Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ДатаПараметра(Знач ПараметрыЗапроса, Знач Имя)
	
	Текст = ЗначениеПараметра(ПараметрыЗапроса, Имя);
	Если ПустаяСтрока(Текст) Тогда
		Возврат НачалоДня(ТекущаяДата());
	КонецЕсли;
	
	Части = СтрРазделить(Текст, "-", Ложь);
	Если Части.Количество() <> 3 Тогда
		ВызватьОшибкуЗапроса(СтрШаблон("Параметр %1 должен быть датой в формате ГГГГ-ММ-ДД, получено ""%2"".", Имя, Текст));
	КонецЕсли;
	
	Попытка
		Год = Число(Части[0]);
		Месяц = Число(Части[1]);
		День = Число(Части[2]);
		Если Год < 1900 ИЛИ Месяц < 1 ИЛИ Месяц > 12 ИЛИ День < 1 ИЛИ День > 31 Тогда
			ВызватьОшибкуЗапроса(СтрШаблон("Параметр %1 содержит недопустимую дату ""%2"".", Имя, Текст));
		КонецЕсли;
		Результат = Дата(Год, Месяц, День);
	Исключение
		// Разбор Число() и конструктор даты могут отказать — сообщаем как ошибку параметра.
		Если СтрНайти(ОписаниеОшибки(), ПрефиксОшибкиЗапроса()) > 0 Тогда
			ВызватьИсключение;
		КонецЕсли;
		ВызватьОшибкуЗапроса(СтрШаблон("Параметр %1 содержит недопустимую дату ""%2"".", Имя, Текст));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ЦелыйПараметр(Знач ПараметрыЗапроса, Знач Имя, Знач ПоУмолчанию, Знач Минимум, Знач Максимум)
	
	Текст = ЗначениеПараметра(ПараметрыЗапроса, Имя);
	Если ПустаяСтрока(Текст) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	
	Попытка
		Значение = Число(Текст);
	Исключение
		ВызватьОшибкуЗапроса(СтрШаблон("Параметр %1 должен быть целым числом, получено ""%2"".", Имя, Текст));
	КонецПопытки;
	
	Значение = Цел(Значение);
	Если Значение < Минимум ИЛИ Значение > Максимум Тогда
		ВызватьОшибкуЗапроса(СтрШаблон(
			"Параметр %1 должен быть в диапазоне от %2 до %3, получено %4.",
			Имя, Минимум, Максимум, Значение));
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ВидПериодаПараметра(Знач ПараметрыЗапроса)
	
	Вид = НРег(ЗначениеПараметра(ПараметрыЗапроса, "period"));
	Если ПустаяСтрока(Вид) Тогда
		Возврат "month";
	КонецЕсли;
	
	Допустимые = Новый Массив;
	Допустимые.Добавить("day");
	Допустимые.Добавить("week");
	Допустимые.Добавить("month");
	Допустимые.Добавить("quarter");
	Допустимые.Добавить("year");
	
	Если Допустимые.Найти(Вид) = Неопределено Тогда
		ВызватьОшибкуЗапроса(СтрШаблон(
			"Параметр period имеет недопустимое значение: ""%1"". Допустимо: day, week, month, quarter, year.", Вид));
	КонецЕсли;
	
	Возврат Вид;
	
КонецФункции

Функция ОрганизацияПараметра(Знач ПараметрыЗапроса)
	
	Текст = ЗначениеПараметра(ПараметрыЗапроса, "organization");
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Ссылка = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Текст));
	Исключение
		ВызватьОшибкуЗапроса(СтрШаблон("Параметр organization не является идентификатором: ""%1"".", Текст));
	КонецПопытки;
	
	// Ссылка на несуществующий элемент не отличается от существующей по значению,
	// поэтому наличие проверяем запросом.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ВызватьОшибкуЗапроса(СтрШаблон("Организация с идентификатором ""%1"" не найдена.", Текст));
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Периоды

Функция ГраницыПериода(Знач ВидПериода, Знач ДатаОтчета)
	
	ДатаС = НачалоЕдиницы(ДатаОтчета, ВидПериода);
	ДатаПо = КонецДня(ДатаОтчета);
	
	// Предыдущий период — та же календарная единица назад, границы внутри неё
	// повторяют смещение даты отчёта от начала периода: 1–11 октября сравниваем
	// с 1–11 сентября, а не с целым сентябрём.
	ДатаСравнения = СдвигНазад(ДатаОтчета, ВидПериода);
	ПредДатаС = НачалоЕдиницы(ДатаСравнения, ВидПериода);
	ПредДатаПо = КонецДня(ДатаСравнения);
	
	Результат = Новый Структура;
	Результат.Вставить("ВидПериода", ВидПериода);
	Результат.Вставить("ДатаС", ДатаС);
	Результат.Вставить("ДатаПо", ДатаПо);
	Результат.Вставить("ПредДатаС", ПредДатаС);
	Результат.Вставить("ПредДатаПо", ПредДатаПо);
	
	Возврат Результат;
	
КонецФункции

Функция НачалоЕдиницы(Знач Дата, Знач ВидПериода)
	
	Если ВидПериода = "day" Тогда
		Возврат НачалоДня(Дата);
	ИначеЕсли ВидПериода = "week" Тогда
		// НачалоНедели() принимает только дату и опирается на региональные настройки:
		// для русской локали неделя начинается с понедельника.
		Возврат НачалоНедели(Дата);
	ИначеЕсли ВидПериода = "quarter" Тогда
		Возврат НачалоКвартала(Дата);
	ИначеЕсли ВидПериода = "year" Тогда
		Возврат НачалоГода(Дата);
	КонецЕсли;
	
	Возврат НачалоМесяца(Дата);
	
КонецФункции

Функция СдвигНазад(Знач Дата, Знач ВидПериода)
	
	Если ВидПериода = "day" Тогда
		Возврат НачалоДня(Дата) - 24 * 60 * 60;
	ИначеЕсли ВидПериода = "week" Тогда
		Возврат НачалоДня(Дата) - 7 * 24 * 60 * 60;
	ИначеЕсли ВидПериода = "quarter" Тогда
		Возврат ДобавитьМесяц(Дата, -3);
	ИначеЕсли ВидПериода = "year" Тогда
		Возврат ДобавитьМесяц(Дата, -12);
	КонецЕсли;
	
	Возврат ДобавитьМесяц(Дата, -1);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Показатели

Функция ПоказателиДенег(Знач ДатаОтчета, Знач Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ДенежныеСредства.СуммаОстаток) КАК Всего,
	|	СУММА(ВЫБОР
	|			КОГДА ДенежныеСредства.ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Безналичные)
	|				ТОГДА ДенежныеСредства.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Безналичные,
	|	СУММА(ВЫБОР
	|			КОГДА ДенежныеСредства.ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
	|				ТОГДА ДенежныеСредства.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Наличные
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.Остатки(&Дата, " + УсловиеОрганизации() + ") КАК ДенежныеСредства";
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаОтчета));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Всего = 0;
	Безналичные = 0;
	Наличные = 0;
	Если Выборка.Следующий() Тогда
		Всего = Окр(НольЕслиПусто(Выборка.Всего, 0), 2);
		Безналичные = Окр(НольЕслиПусто(Выборка.Безналичные, 0), 2);
		Наличные = Окр(НольЕслиПусто(Выборка.Наличные, 0), 2);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("total", Всего);
	Результат.Вставить("accounts", Безналичные);
	Результат.Вставить("cash", Наличные);
	Результат.Вставить("currency", "RUB");
	
	Возврат Результат;
	
КонецФункции

Функция ПоказателиПродаж(Знач ДатаС, Знач ДатаПо, Знач Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Продажи.СуммаОборот) КАК Выручка,
	|	СУММА(Продажи.СуммаНДСОборот) КАК НДС,
	|	СУММА(Продажи.СебестоимостьОборот) КАК Себестоимость,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА Продажи.Регистратор ССЫЛКА Документ.ЗакрытиеМесяца
	|				ТОГДА NULL
	|			ИНАЧЕ Продажи.Регистратор
	|		КОНЕЦ) КАК Документов
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, Авто, " + УсловиеОрганизации() + ") КАК Продажи";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПо));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Результат.Вставить("Выручка", 0);
	Результат.Вставить("НДС", 0);
	Результат.Вставить("Себестоимость", 0);
	Результат.Вставить("Документов", 0);
	
	Если Выборка.Следующий() Тогда
		Результат.Выручка = Окр(НольЕслиПусто(Выборка.Выручка, 0), 2);
		Результат.НДС = Окр(НольЕслиПусто(Выборка.НДС, 0), 2);
		Результат.Себестоимость = Окр(НольЕслиПусто(Выборка.Себестоимость, 0), 2);
		Результат.Документов = НольЕслиПусто(Выборка.Документов, 0);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПоказателиПродажДляОтвета(Знач Текущие, Знач Прошлые)
	
	Прибыль = Окр(Текущие.Выручка - Текущие.Себестоимость, 2);
	ПрибыльПрошлая = Окр(Прошлые.Выручка - Прошлые.Себестоимость, 2);
	
	Документов = Текущие.Документов;
	СреднийЧек = 0;
	Если Документов > 0 Тогда
		СреднийЧек = Окр(Текущие.Выручка / Документов, 2);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("revenue", Текущие.Выручка);
	Результат.Вставить("revenuePrev", Прошлые.Выручка);
	Результат.Вставить("revenueDeltaPct", Процент(Текущие.Выручка - Прошлые.Выручка, Прошлые.Выручка));
	Результат.Вставить("revenueNet", Окр(Текущие.Выручка - Текущие.НДС, 2));
	Результат.Вставить("grossProfit", Прибыль);
	Результат.Вставить("grossProfitPrev", ПрибыльПрошлая);
	Результат.Вставить("marginPct", Процент(Прибыль, Текущие.Выручка));
	Результат.Вставить("documents", Документов);
	Результат.Вставить("avgTicket", СреднийЧек);
	
	Возврат Результат;
	
КонецФункции

Функция ПоказателиЗапасов(Знач ДатаОтчета, Знач Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Запасы.СуммаОстаток) КАК Стоимость,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА Запасы.КоличествоОстаток <> 0
	|				ТОГДА Запасы.Номенклатура
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК Номенклатур,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА Запасы.КоличествоОстаток < 0
	|				ТОГДА Запасы.Номенклатура
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК Отрицательных
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(&Дата,
	|			СчетУчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Запасы)
	|				И (" + УсловиеОрганизации() + ")) КАК Запасы";
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаОтчета));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Стоимость = 0;
	Номенклатур = 0;
	Отрицательных = 0;
	Если Выборка.Следующий() Тогда
		Стоимость = Окр(НольЕслиПусто(Выборка.Стоимость, 0), 2);
		Номенклатур = НольЕслиПусто(Выборка.Номенклатур, 0);
		Отрицательных = НольЕслиПусто(Выборка.Отрицательных, 0);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("total", Стоимость);
	Результат.Вставить("skuCount", Номенклатур);
	Результат.Вставить("negativeCount", Отрицательных);
	
	Возврат Результат;
	
КонецФункции

Функция ПоказателиЗаказов(Знач ДатаОтчета, Знач ДатаС, Знач ДатаПо, Знач Организация)
	
	// Портфель — открытые заказы покупателей: по заказу есть неотгруженный остаток.
	// Сумма берётся из документа (СуммаДокумента) один раз на заказ, поэтому
	// промежуточная выборка сворачивается по заказу.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Портфель.Сумма) КАК Портфель,
	|	КОЛИЧЕСТВО(Портфель.Заказ) КАК Заказов,
	|	СУММА(Портфель.Позиций) КАК Позиций,
	|	СУММА(ВЫБОР
	|			КОГДА Портфель.ДатаОтгрузки <> ДАТАВРЕМЯ(1, 1, 1)
	|					И Портфель.ДатаОтгрузки < &Дата
	|				ТОГДА Портфель.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПросроченоСумма,
	|	КОЛИЧЕСТВО(ВЫБОР
	|			КОГДА Портфель.ДатаОтгрузки <> ДАТАВРЕМЯ(1, 1, 1)
	|					И Портфель.ДатаОтгрузки < &Дата
	|				ТОГДА Портфель.Заказ
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК ПросроченоЗаказов,
	|	СУММА(ВЫБОР
	|			КОГДА Портфель.ДатаОтгрузки <> ДАТАВРЕМЯ(1, 1, 1)
	|					И Портфель.ДатаОтгрузки >= &Дата
	|					И Портфель.ДатаОтгрузки <= &Неделя
	|				ТОГДА Портфель.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КОтгрузкеНаНеделе
	|ИЗ
	|	(ВЫБРАТЬ
	|		Заказы.ЗаказПокупателя КАК Заказ,
	|		Заказы.ЗаказПокупателя.СуммаДокумента КАК Сумма,
	|		СУММА(Заказы.КоличествоОстаток) КАК Позиций,
	|		МИНИМУМ(Заказы.ЗаказПокупателя.ДатаОтгрузки) КАК ДатаОтгрузки
	|	ИЗ
		|	РегистрНакопления.ЗаказыПокупателей.Остатки(&Дата,
	|			(" + УсловиеОрганизации() + ")) КАК Заказы
	|	ГДЕ
	|		Заказы.КоличествоОстаток > 0
	|	СГРУППИРОВАТЬ ПО
	|		Заказы.ЗаказПокупателя,
	|		Заказы.ЗаказПокупателя.СуммаДокумента) КАК Портфель";
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаОтчета));
	Запрос.УстановитьПараметр("Неделя", КонецДня(ДатаОтчета + 7 * 24 * 60 * 60));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Портфель = 0;
	Заказов = 0;
	Позиций = 0;
	ПросроченоСумма = 0;
	ПросроченоЗаказов = 0;
	КОтгрузкеНаНеделе = 0;
	Если Выборка.Следующий() Тогда
		Портфель = Окр(НольЕслиПусто(Выборка.Портфель, 0), 2);
		Заказов = НольЕслиПусто(Выборка.Заказов, 0);
		Позиций = Окр(НольЕслиПусто(Выборка.Позиций, 0), 3);
		ПросроченоСумма = Окр(НольЕслиПусто(Выборка.ПросроченоСумма, 0), 2);
		ПросроченоЗаказов = НольЕслиПусто(Выборка.ПросроченоЗаказов, 0);
		КОтгрузкеНаНеделе = Окр(НольЕслиПусто(Выборка.КОтгрузкеНаНеделе, 0), 2);
	КонецЕсли;
	
	// Сумма и количество заказов, зарегистрированных за период, и оплата по ним.
	ЗапросОплат = Новый Запрос;
	ЗапросОплат.Текст =
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА Оплата.СуммаОборот > 0
	|				ТОГДА Оплата.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Заказано,
	|	СУММА(Оплата.СуммаОплатыОборот + Оплата.СуммаАвансаОборот) КАК Оплачено
	|ИЗ
	|	РегистрНакопления.ОплатаСчетовИЗаказов.Обороты(&ДатаНачала, &ДатаОкончания, Авто,
	|			СчетНаОплату ССЫЛКА Документ.ЗаказПокупателя
	|				И (" + УсловиеОрганизации() + ")) КАК Оплата";
	ЗапросОплат.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаС));
	ЗапросОплат.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПо));
	ЗапросОплат.УстановитьПараметр("Организация", Организация);
	
	ВыборкаОплат = ЗапросОплат.Выполнить().Выбрать();
	
	Заказано = 0;
	Оплачено = 0;
	Если ВыборкаОплат.Следующий() Тогда
		Заказано = Окр(НольЕслиПусто(ВыборкаОплат.Заказано, 0), 2);
		Оплачено = Окр(НольЕслиПусто(ВыборкаОплат.Оплачено, 0), 2);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("portfolio", Портфель);
	Результат.Вставить("count", Заказов);
	Результат.Вставить("positions", Позиций);
	Результат.Вставить("overdueCount", ПросроченоЗаказов);
	Результат.Вставить("overdueAmount", ПросроченоСумма);
	Результат.Вставить("dueThisWeek", КОтгрузкеНаНеделе);
	Результат.Вставить("orderedAmount", Заказано);
	Результат.Вставить("paidAmount", Оплачено);
	
	Возврат Результат;
	
КонецФункции

// Считает задолженность и её возраст. Вид: "receivable" — нам должны,
// "payable" — мы должны.
//
// Формулы повторяют типовую УНФ: возраст долга считается от даты расчётного
// документа, просрочка — от срока оплаты по договору.
//
// Реквизит срока оплаты у покупателей и поставщиков разный:
// СрокОплатыПокупателя и СрокОплатыПоставщику. В типовой секции кредиторки
// («СостояниеКомпании») ошибочно читается покупательский реквизит; здесь взят
// правильный — тот же, что использует типовой отчёт «Реестр старения
// кредиторской задолженности».
Функция ЗадолженностьПоКонтрагентамВнутренняя(Знач Вид, Знач ДатаОтчета, Знач Организация)
	
	Если Вид = "payable" Тогда
		ИмяРегистра = "РасчетыСПоставщиками";
		ИмяРеквизитаСрока = "СрокОплатыПоставщику";
	Иначе
		ИмяРегистра = "РасчетыСПокупателями";
		ИмяРеквизитаСрока = "СрокОплатыПокупателя";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Расчеты.Контрагент КАК Контрагент,
	|	СУММА(Расчеты.СуммаОстаток) КАК Сумма,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(Расчеты.Договор.%2, 0) > 0
	|					И РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) > Расчеты.Договор.%2
	|				ТОГДА Расчеты.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Просроченная,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(Расчеты.Договор.%2, 0) > 0
	|					И РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) > Расчеты.Договор.%2
	|				ТОГДА РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) - Расчеты.Договор.%2
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК МаксПросрочка,
	|	СУММА(ВЫБОР
	|			КОГДА РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) <= 7
	|				ТОГДА Расчеты.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Возраст1,
	|	СУММА(ВЫБОР
	|			КОГДА РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) > 7
	|					И РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) <= 14
	|				ТОГДА Расчеты.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Возраст2,
	|	СУММА(ВЫБОР
	|			КОГДА РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) > 14
	|					И РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) <= 30
	|				ТОГДА Расчеты.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Возраст3,
	|	СУММА(ВЫБОР
	|			КОГДА РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) > 30
	|					И РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) <= 60
	|				ТОГДА Расчеты.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Возраст4,
	|	СУММА(ВЫБОР
	|			КОГДА РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) > 60
	|				ТОГДА Расчеты.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Возраст5
	|ИЗ
	|	РегистрНакопления.%1.Остатки(&Дата,
	|			(" + УсловиеОрганизации() + ")
	|				И ТипРасчетов = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)) КАК Расчеты
	|ГДЕ
	|	Расчеты.Документ <> НЕОПРЕДЕЛЕНО
	|	И Расчеты.СуммаОстаток > 0
	|	И Расчеты.СуммаВалОстаток > 0
	|	И РАЗНОСТЬДАТ(Расчеты.Документ.Дата, &Дата, ДЕНЬ) >= 0
	|СГРУППИРОВАТЬ ПО
	|	Расчеты.Контрагент
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ", ИмяРегистра, ИмяРеквизитаСрока);
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаОтчета));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Всего = 0;
	Просрочено = 0;
	Возраст = Новый Массив;
	Возраст.Добавить(0);  // 0–7 дней
	Возраст.Добавить(0);  // 8–14
	Возраст.Добавить(0);  // 15–30
	Возраст.Добавить(0);  // 31–60
	Возраст.Добавить(0);  // свыше 60
	ПоКонтрагентам = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Сумма = Окр(НольЕслиПусто(Выборка.Сумма, 0), 2);
		ПросроченнаяСумма = Окр(НольЕслиПусто(Выборка.Просроченная, 0), 2);
		
		СтрокиВозраста = Новый Массив;
		СтрокиВозраста.Добавить(Окр(НольЕслиПусто(Выборка.Возраст1, 0), 2));
		СтрокиВозраста.Добавить(Окр(НольЕслиПусто(Выборка.Возраст2, 0), 2));
		СтрокиВозраста.Добавить(Окр(НольЕслиПусто(Выборка.Возраст3, 0), 2));
		СтрокиВозраста.Добавить(Окр(НольЕслиПусто(Выборка.Возраст4, 0), 2));
		СтрокиВозраста.Добавить(Окр(НольЕслиПусто(Выборка.Возраст5, 0), 2));
		
		Для Индекс = 0 По 4 Цикл
			Возраст[Индекс] = Возраст[Индекс] + СтрокиВозраста[Индекс];
		КонецЦикла;
		
		Всего = Всего + Сумма;
		Просрочено = Просрочено + ПросроченнаяСумма;
		
		Контрагент = Новый Структура;
		Контрагент.Вставить("name", СокрЛП(Строка(Выборка.Контрагент)));
		Контрагент.Вставить("amount", Сумма);
		Контрагент.Вставить("overdue", ПросроченнаяСумма);
		Контрагент.Вставить("maxOverdueDays", НольЕслиПусто(Выборка.МаксПросрочка, 0));
		Контрагент.Вставить("buckets", ВозрастныеКорзины(СтрокиВозраста));
		ПоКонтрагентам.Добавить(Контрагент);
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Всего", Окр(Всего, 2));
	Результат.Вставить("Просрочено", Окр(Просрочено, 2));
	Результат.Вставить("Корзины", ВозрастныеКорзины(Возраст));
	Результат.Вставить("ПоКонтрагентам", ПоКонтрагентам);
	
	Возврат Результат;
	
КонецФункции

Функция ПоказателиЗадолженностиДляОтвета(Знач Данные)
	
	Результат = Новый Структура;
	Результат.Вставить("total", Данные.Всего);
	Результат.Вставить("overdue", Данные.Просрочено);
	Результат.Вставить("overduePct", Процент(Данные.Просрочено, Данные.Всего));
	Результат.Вставить("buckets", Данные.Корзины);
	
	Возврат Результат;
	
КонецФункции

Функция ВозрастныеКорзины(Знач Суммы)
	
	Подписи = Новый Массив;
	Подписи.Добавить("0–7 дней");
	Подписи.Добавить("8–14 дней");
	Подписи.Добавить("15–30 дней");
	Подписи.Добавить("31–60 дней");
	Подписи.Добавить("Свыше 60 дней");
	
	Корзины = Новый Массив;
	Для Индекс = 0 По 4 Цикл
		Корзина = Новый Структура;
		Корзина.Вставить("label", Подписи[Индекс]);
		Корзина.Вставить("amount", Суммы[Индекс]);
		Корзины.Добавить(Корзина);
	КонецЦикла;
	
	Возврат Корзины;
	
КонецФункции

Функция ПервыеПоСумме(Знач ПоКонтрагентам, Знач Предел, Знач СДетализацией = Ложь)
	
	Результат = Новый Массив;
	Счетчик = 0;
	
	Для Каждого Контрагент Из ПоКонтрагентам Цикл
		Если Счетчик >= Предел Тогда
			Прервать;
		КонецЕсли;
		
		Элемент = Новый Структура;
		Элемент.Вставить("name", Контрагент.name);
		Элемент.Вставить("amount", Контрагент.amount);
		Элемент.Вставить("overdue", Контрагент.overdue);
		Элемент.Вставить("maxOverdueDays", Контрагент.maxOverdueDays);
		Если СДетализацией Тогда
			Элемент.Вставить("buckets", Контрагент.buckets);
		КонецЕсли;
		Результат.Добавить(Элемент);
		
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
