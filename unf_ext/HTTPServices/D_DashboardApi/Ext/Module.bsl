////////////////////////////////////////////////////////////////////////////////
// Модуль HTTP-сервиса D_DashboardApi.
//
// Тонкий слой: разобрать запрос, вызвать D_Показатели, вернуть JSON.
// Вся бизнес-логика живёт в общем модуле D_Показатели — здесь её нет,
// чтобы расчёт можно было использовать и вне HTTP (например, из регламентного задания).
//
// Имена обработчиков совпадают с Handler в HTTPServices/D_DashboardApi.xml.

// GET /health — проверка доступности. Данные не читает.
// Параметр обязателен: платформа привязывает обработчик с ровно одним параметром,
// иначе модуль сервиса не инициализируется («Ошибка инициализации модуля»).
Функция healthGET(Запрос) Экспорт
	
	Попытка
		Возврат D_Показатели.УспешныйОтвет(D_Показатели.СведенияОСервисе());
	Исключение
		Возврат D_Показатели.ОтветОшибки(ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

// GET /organizations — список организаций.
Функция organizationsGET(Запрос) Экспорт
	
	Попытка
		Возврат D_Показатели.УспешныйОтвет(D_Показатели.СписокОрганизаций());
	Исключение
		Возврат D_Показатели.ОтветОшибки(ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

// GET /kpi — сводка показателей.
//
// Параметры запроса: date (ГГГГ-ММ-ДД), period (day|week|month|quarter|year),
// organization (идентификатор организации).
Функция kpiGET(Запрос) Экспорт
	
	Попытка
		Параметры = D_Показатели.ПараметрыKPI(Запрос.ПараметрыЗапроса);
		Возврат D_Показатели.УспешныйОтвет(D_Показатели.СводкаПоказателей(Параметры));
	Исключение
		Возврат D_Показатели.ОтветОшибки(ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

// GET /dynamics — выручка, прибыль и рентабельность по месяцам.
//
// Параметры запроса: months (1–36), date, organization.
Функция dynamicsGET(Запрос) Экспорт
	
	Попытка
		Параметры = D_Показатели.ПараметрыДинамики(Запрос.ПараметрыЗапроса);
		Возврат D_Показатели.УспешныйОтвет(D_Показатели.ДинамикаПоказателей(Параметры));
	Исключение
		Возврат D_Показатели.ОтветОшибки(ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

// GET /debtors — задолженность в разрезе контрагентов.
//
// Параметры запроса: kind (receivable|payable), limit (1–100), date, organization.
Функция debtorsGET(Запрос) Экспорт
	
	Попытка
		Параметры = D_Показатели.ПараметрыЗадолженности(Запрос.ПараметрыЗапроса);
		Возврат D_Показатели.УспешныйОтвет(D_Показатели.ЗадолженностьПоКонтрагентам(Параметры));
	Исключение
		Возврат D_Показатели.ОтветОшибки(ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции
