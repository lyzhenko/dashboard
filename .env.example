# Переменные стенда. Скопируйте в .env и заполните секреты.
# Сам .env в репозиторий не попадает (см. .gitignore).

# --- Стенд целиком ---
COMPOSE_PROJECT_NAME=dashboard

# Порт, на котором стенд открывается в браузере.
# 8090 выбран потому, что 8080 занят IIS (см. AGENT.md).
STAND_PORT=8090

# --- PostgreSQL 17 ---
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change-me-postgres-password

# --- Бэкенд ---
# Внутри compose бэкенд ходит в базу по имени сервиса db.
DATABASE_URL=postgresql+psycopg://dashboard:change-me-postgres-password@db:5432/dashboard

# Секрет подписи JWT. Обязателен, не короче 32 байт — иначе приложение не стартует.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret-min-32-bytes-long-0123456789

# Время жизни токенов, секунды: 15 минут и 14 дней.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Cookie с refresh-токеном: на стенде (HTTPS) поставьте true.
COOKIE_SECURE=false

# --- 1С: HTTP-сервис расширения D_DashboardApi ---
# Адрес публикации базы. На этой машине база опубликована как /novofon на порту 8080
# (см. docs/ПАМЯТЬ-проекта.md). Если публикуете скриптом tools/publish-base.ps1,
# адрес будет http://localhost:8090/unf/hs/dashboard.
# Из контейнера хост доступен как host.docker.internal.
ONE_C_BASE_URL=http://localhost:8080/novofon/hs/dashboard
# Пользователь 1С, у которого есть роль расширения D_ОсновнаяРоль и права на чтение
# регистров из ролей основной конфигурации. В демо-базе это Администратор без пароля.
ONE_C_USER=Администратор
ONE_C_PASSWORD=
ONE_C_TIMEOUT_SECONDS=20
# Учитывать системные настройки прокси при обращении к 1С. Оставьте false, если
# публикация 1С доступна напрямую: иначе на Windows запрос уйдёт через системный
# прокси (httpx читает его из реестра) и вернётся 503 от прокси, а не от 1С.
ONE_C_TRUST_ENV=false

# --- Кэш показателей ---
KPI_CACHE_TTL_SECONDS=300

# --- Служебное ---
LOG_LEVEL=INFO
# Создавать демо-пользователя rukovoditel/dashboard при старте контейнера.
# Только для разработки: на рабочем стенде оставьте false и создайте пользователя CLI.
SEED_DEMO_USER=false
